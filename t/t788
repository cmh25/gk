ty[{do[abs;`x]};0]
ty[{while[abs;`x]};0]
ty[{:[abs;`t;`f]};0]
ty[{a:0;if[abs;a:1]};0]
ty[{a:0;do[abs;a+:1]};0]
ty[{a:0;while[abs;a+:1]};0]
ty[{a:0;:[abs;a:1;a:2]};0]

